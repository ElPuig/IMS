<odoo>
    <data>
        <record model="ir.ui.view" id="view_employee_search">
            <field name="name">ems.employee.search</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <filter name="newly_hired" position="after">
                    <filter name="pending_identification" string="Pending identification"
                            domain="[('pending_identification', '=', True)]"/>
                    <!-- Google account lifecycle (#388), restricted to the roles that can
                         act on those accounts - same groups as the form's own buttons.
                         Only suspension: staff accounts are never deleted. Combine it
                         with the standard Archived filter, since every match is
                         archived by definition. -->
                    <filter name="gw_deactivation_pending" string="Google suspension pending"
                            domain="[('google_ws_deactivation_date', '!=', False)]"
                            groups="ems.group_academic_admin,hr.group_hr_user"/>
                </filter>

                <filter name="group_job" position="after">
                    <filter name="group_pending_identification" string="Pending identification"
                            domain="[]" context="{'group_by': 'pending_identification'}"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>
